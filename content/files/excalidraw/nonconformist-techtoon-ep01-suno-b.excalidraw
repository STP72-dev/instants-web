   "link": null,
   "locked": false,
   "text": "\"Begin exactly where the recording ends, with no restart or new melody.\"\n\"Reduce density rather than changing the groove: isolated conga hits,\n negative space, little rim clicks, muted echoes, tiny pitch bends and\n subtle filter motion.\"\n\"Cycle between the recognizable bass-driven loop and brief percussion-only\n pockets, using restrained variations to create tension over many bars.\"",
   "originalText": "\"Begin exactly where the recording ends, with no restart or new melody.\"\n\"Reduce density rather than changing the groove: isolated conga hits,\n negative space, little rim clicks, muted echoes, tiny pitch bends and\n subtle filter motion.\"\n\"Cycle between the recognizable bass-driven loop and brief percussion-only\n pockets, using restrained variations to create tension over many bars.\"",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },

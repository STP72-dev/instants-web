---
/**
 * Excalidraw per DECISIONS.md D2: the export PNG first (labelled, with a stale note), otherwise an SVG rendered
 * client-side from the source; the read-only interactive canvas loads only after "Open interactive canvas".
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import sharp from 'sharp';
import { fileUrl } from '../../lib/content.ts';
import type { FormatAsset } from '../../lib/manifest.ts';

interface Props {
  asset: FormatAsset;
  title: string;
  /** Prefix for element ids, unique per page. */
  id: string;
}

const { asset, title, id } = Astro.props;
const content = (path: string) => join(process.cwd(), 'content', path);
const png = asset.exports.png;
const size = png ? await sharp(content(png.path)).metadata() : null;
const sourceUrl = fileUrl(asset.source.path);

// The drawing's own canvas colour frames the preview so letterboxing blends in. Only a plain hex is accepted.
let background = '';
try {
  const color = JSON.parse(readFileSync(content(asset.source.path), 'utf8'))?.appState?.viewBackgroundColor;
  if (typeof color === 'string' && /^#[0-9a-f]{3,8}$/i.test(color)) background = `--canvas-bg: ${color};`;
} catch {
  // Unreadable scene: the client-side renderer reports it; the frame falls back to the surface colour.
}
---

<figure class="exc" data-excalidraw data-src={sourceUrl} data-state={png ? 'png' : 'pending'} aria-labelledby={`${id}-caption`}>
  <div class="frame" style={background}>
    {
      png ? (
        <a class="zoom" href={fileUrl(png.path)} aria-label={`Open full-size PNG: ${title}`}>
          <img src={fileUrl(png.path)} alt={title} width={size?.width} height={size?.height} loading="lazy" decoding="async" />
        </a>
      ) : (
        <div class="svg-target" data-exc-svg role="img" aria-label={title}>
          <p class="status" data-exc-status>
            Sketch renders when it scrolls into view.
          </p>
        </div>
      )
    }
  </div>
  <figcaption id={`${id}-caption`}>
    <p class="labels">
      {
        png ? (
          <>
            <span class="badge">Export preview</span>
            {png.freshness === 'stale' && <span class="badge warn">May be older than the source</span>}
          </>
        ) : (
          <span class="badge">Rendered live from source · no PNG export yet</span>
        )
      }
      <span class="visually-hidden">: {title}</span>
    </p>
    <div class="actions">
      <button type="button" class="open" data-exc-open aria-haspopup="dialog" aria-controls={`${id}-dialog`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
        Open interactive canvas
      </button>
      {png && <a class="link" href={fileUrl(png.path)}>Full-size PNG</a>}
    </div>
  </figcaption>
</figure>

<dialog class="exc-dialog" id={`${id}-dialog`} aria-labelledby={`${id}-dialog-title`} data-exc-dialog>
  <div class="bar">
    <div>
      <p class="eyebrow">Interactive canvas · read-only</p>
      <h2 id={`${id}-dialog-title`}>{title}</h2>
    </div>
    <button type="button" class="close" data-exc-close>
      Close <kbd aria-hidden="true">Esc</kbd>
    </button>
  </div>
  <div class="mount" data-exc-mount>
    <p class="status" data-exc-dialog-status>Loading canvas…</p>
  </div>
</dialog>

<script>
  // Excalidraw fetches fonts from `${EXCALIDRAW_ASSET_PATH}fonts/…`; /excalidraw/ mirrors @excalidraw/excalidraw/dist/prod/fonts on our origin.
  (window as unknown as { EXCALIDRAW_ASSET_PATH: string }).EXCALIDRAW_ASSET_PATH = '/excalidraw/';

  const client = () => import('./excalidraw.ts');

  for (const figure of document.querySelectorAll<HTMLElement>('[data-excalidraw]')) {
    const src = figure.dataset.src!;
    const svgTarget = figure.querySelector<HTMLElement>('[data-exc-svg]');
    const dialog = figure.nextElementSibling as HTMLDialogElement | null;
    const openButton = figure.querySelector<HTMLButtonElement>('[data-exc-open]');

    // No export PNG: render an SVG from the source once the figure nears the viewport.
    if (svgTarget) {
      const renderSvg = async () => {
        figure.dataset.state = 'loading';
        const status = svgTarget.querySelector('[data-exc-status]');
        if (status) status.textContent = 'Rendering sketch…';
        try {
          const svg = await (await client()).renderSvg(src);
          svg.setAttribute('aria-hidden', 'true');
          svgTarget.replaceChildren(svg);
          figure.dataset.state = 'ready';
        } catch (error) {
          figure.dataset.state = 'error';
          if (status) status.textContent = `The sketch could not be rendered (${error instanceof Error ? error.message : 'unknown error'}). Download the source below.`;
        }
      };
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          observer.disconnect();
          void renderSvg();
        },
        { rootMargin: '300px 0px' },
      );
      observer.observe(figure);
    }

    if (!dialog || !openButton) continue;
    const mount = dialog.querySelector<HTMLElement>('[data-exc-mount]')!;
    const status = dialog.querySelector<HTMLElement>('[data-exc-dialog-status]')!;
    let unmount: (() => void) | undefined;
    let abort: AbortController | undefined;
    // Each open gets a generation; closing bumps it, so a mount that resolves after the dialog closed is discarded.
    let generation = 0;

    openButton.addEventListener('click', async () => {
      if (dialog.open) return;
      const current = ++generation;
      const controller = (abort = new AbortController());
      const stale = () => current !== generation || !dialog.open;
      status.hidden = false;
      status.textContent = 'Loading canvas…';
      dialog.showModal();
      dialog.querySelector<HTMLButtonElement>('[data-exc-close]')?.focus();
      const host = document.createElement('div');
      host.className = 'host';
      mount.append(host);
      try {
        const { mountViewer } = await client();
        if (stale()) return;
        const dispose = await mountViewer(host, src, controller.signal);
        if (stale()) {
          dispose();
          return;
        }
        unmount = dispose;
        status.hidden = true;
      } catch (error) {
        if (stale()) return;
        status.textContent = `The canvas could not be loaded (${error instanceof Error ? error.message : 'unknown error'}).`;
      }
    });

    // Escape always closes, even when the canvas has focus and handles keys itself.
    dialog.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Escape') return;
        event.preventDefault();
        event.stopPropagation();
        dialog.close();
      },
      { capture: true },
    );
    dialog.querySelector('[data-exc-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      generation++;
      abort?.abort();
      unmount?.();
      unmount = undefined;
      mount.querySelectorAll('.host').forEach((host) => host.remove());
      openButton.focus();
    });
  }
</script>

<style>
  .exc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin: 0;
  }

  .frame {
    background: var(--canvas-bg, var(--bg-raised));
    border: 1px solid var(--line);
    border-radius: var(--radius-2);
    overflow: hidden;
  }

  .zoom {
    display: block;
    cursor: zoom-in;
  }

  .zoom img {
    width: 100%;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .zoom:hover img {
    transform: scale(1.01);
  }

  .zoom:focus-visible {
    outline-offset: -4px;
  }

  .svg-target {
    display: grid;
    place-items: center;
    min-height: 16rem;
    padding: var(--space-3);
  }

  .svg-target :global(svg) {
    width: 100%;
    height: auto;
    animation: rise var(--dur-3) var(--ease-out) both;
  }

  .status {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
    text-align: center;
    padding: var(--space-5);
  }

  .exc[data-state='error'] .status {
    color: var(--accent-rose);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .labels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--line-strong);
    color: var(--text-muted);
  }

  .badge.warn {
    color: var(--accent-amber);
    border-color: color-mix(in oklab, var(--accent-amber) 45%, transparent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .open {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding: 0 var(--space-4);
    border: 1px solid color-mix(in oklab, var(--accent) 55%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--accent) 10%, transparent);
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--ease-out),
      transform var(--dur-1) var(--ease-out);
  }

  .open:hover {
    background: color-mix(in oklab, var(--accent) 20%, transparent);
  }

  .open:active {
    transform: translateY(1px);
  }

  .open svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .link {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .exc-dialog {
    width: calc(100vw - 2 * var(--space-4));
    height: calc(100dvh - 2 * var(--space-4));
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-3);
    background: var(--bg-raised);
    color: var(--text);
    overflow: hidden;
  }

  .exc-dialog[open] {
    display: flex;
    flex-direction: column;
    animation: rise var(--dur-2) var(--ease-out) both;
  }

  .exc-dialog::backdrop {
    background: rgb(0 0 0 / 0.72);
    backdrop-filter: blur(4px);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4) var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--line);
  }

  .bar h2 {
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .close {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
    min-height: 2.5rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: var(--surface);
    cursor: pointer;
  }

  .close:hover {
    background: var(--surface-hover);
  }

  .close kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    padding: 0 0.3rem;
  }

  .mount {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  .mount .status:not([hidden]) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .mount :global(.host) {
    position: absolute;
    inset: 0;
  }

  :global(html:has(.exc-dialog[open])) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .exc-dialog[open],
    .svg-target :global(svg) {
      animation: none;
    }
  }
</style>

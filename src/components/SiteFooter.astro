---
import { manifest } from '../lib/content.ts';

const source = manifest.source;
---

<footer class="site-footer">
  <div class="container row">
    <p class="eyebrow">INSTANTS · open → copy → done</p>
    <p class="meta">
      {manifest.counts.entries} entries · {manifest.counts.topics} topics
      {source && <> · snapshot <code>{source.commit.slice(0, 7)}</code> · {source.committedAt.slice(0, 10)}</>}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    border-top: 1px solid var(--line);
    padding-block: var(--space-6);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .meta {
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  code {
    font-family: var(--font-mono);
    color: var(--text-muted);
  }
</style>

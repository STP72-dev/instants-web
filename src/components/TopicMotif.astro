---
/**
 * Decorative per-topic motif (aria-hidden). Music: a step-sequencer / waveform strip.
 * Technical: a node-and-edge constellation. Shapes are seeded from the topic slug so each topic
 * gets its own stable pattern without a hand-maintained list.
 */
import type { TopicKind } from '../lib/manifest.ts';

interface Props {
  slug: string;
  kind: TopicKind;
  class?: string;
}

const { slug, kind, class: className } = Astro.props;

// Small deterministic PRNG (mulberry32) seeded by the slug.
let seed = [...slug].reduce((h, c) => Math.imul(h ^ c.charCodeAt(0), 2654435761) >>> 0, 2166136261);
const rand = () => {
  seed = (seed + 0x6d2b79f5) >>> 0;
  let t = seed;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const W = 400;
const H = 120;
const bars = Array.from({ length: 48 }, (_, i) => {
  const h = 8 + rand() * 0.6 * H * (0.55 + 0.45 * Math.sin(i / 4));
  return { x: i * (W / 48) + 1, h: Math.max(6, h), on: rand() > 0.72 };
});
const nodes = Array.from({ length: 11 }, () => ({ x: 12 + rand() * (W - 24), y: 12 + rand() * (H - 24), r: 1.5 + rand() * 2.5 }));
const edges = nodes.flatMap((a, i) =>
  nodes
    .slice(i + 1)
    .filter((b) => Math.hypot(a.x - b.x, a.y - b.y) < 120)
    .map((b) => ({ a, b })),
);
---

<svg class:list={['motif', className]} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
  {
    kind === 'music'
      ? bars.map((b) => (
          <rect x={b.x} y={(H - b.h) / 2} width={W / 48 - 3} height={b.h} rx="1.5" class:list={['bar', { on: b.on }]} />
        ))
      : [
          ...edges.map(({ a, b }) => <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} class="edge" />),
          ...nodes.map((n) => <circle cx={n.x} cy={n.y} r={n.r} class="node" />),
        ]
  }
</svg>

<style>
  .motif {
    width: 100%;
    height: 100%;
  }

  .bar {
    fill: color-mix(in oklab, var(--accent) 22%, transparent);
  }

  .bar.on {
    fill: var(--accent);
  }

  .edge {
    stroke: color-mix(in oklab, var(--accent) 30%, transparent);
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
  }

  .node {
    fill: var(--accent);
  }
</style>

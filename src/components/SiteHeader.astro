---
import { orderedTopics, topicUrl } from '../lib/content.ts';

interface Props {
  section?: 'home' | 'topics' | 'search' | undefined;
}

const { section } = Astro.props;
const topics = orderedTopics();
---

<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href="/" aria-current={section === 'home' ? 'page' : undefined}>
      <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M13.5 2 5 13.5h6L9.5 22 19 9.5h-6.2L13.5 2Z" />
      </svg>
      <span>INSTANTS</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        <li class="topics-menu">
          <details>
            <summary aria-current={section === 'topics' ? 'true' : undefined}>Topics</summary>
            <ul class="menu">
              {
                topics.map((t) => (
                  <li>
                    <a href={topicUrl(t.slug)}>
                      <span>{t.title}</span>
                      <span class="count">{t.entries.length}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
        <li>
          <a class="search-link" href="/search/" aria-current={section === 'search' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg>
            <span>Search</span>
            <kbd aria-hidden="true">/</kbd>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // "/" focuses search from anywhere (except while typing in a field).
  document.addEventListener('keydown', (event) => {
    if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target as HTMLElement | null;
    if (target && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))) return;
    const field = document.querySelector<HTMLInputElement>('#search-input');
    event.preventDefault();
    if (field) field.focus();
    else window.location.href = '/search/';
  });

  // Close the topics menu on Escape or outside click.
  const menu = document.querySelector<HTMLDetailsElement>('.topics-menu details');
  if (menu) {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px) saturate(140%);
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 3.75rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.18em;
    text-decoration: none;
  }

  .mark {
    width: 1.15rem;
    height: 1.15rem;
    fill: var(--accent);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .wordmark:hover .mark {
    transform: rotate(-12deg) scale(1.08);
  }

  nav > ul {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  summary,
  .search-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    font-size: 0.92rem;
    text-decoration: none;
    cursor: pointer;
    transition:
      color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }

  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
  }

  summary:hover,
  .search-link:hover,
  details[open] summary,
  [aria-current] {
    color: var(--text);
    background: var(--surface);
  }

  .search-link svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  kbd {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    color: var(--text-faint);
  }

  .topics-menu {
    position: relative;
  }

  .menu {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    min-width: 16rem;
    padding: var(--space-2);
    list-style: none;
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-2);
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.8);
  }

  .menu a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-1);
    text-decoration: none;
    color: var(--text-muted);
  }

  .menu a:hover,
  .menu a:focus-visible {
    background: var(--surface-hover);
    color: var(--text);
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  @media (max-width: 30rem) {
    .search-link span,
    kbd {
      display: none;
    }
  }
</style>

---
import type { Entry } from '../lib/manifest.ts';
import { entryUrl, formatsOf, FORMAT_SHORT, ROLE_LABEL, thumbnail } from '../lib/content.ts';

interface Props {
  entry: Entry;
  /** Optional step number shown in story / guided-path layouts. */
  step?: number;
  /** Heading level for the card title, so cards nest correctly under section headings. */
  level?: 2 | 3 | 4;
  showPreview?: boolean;
}

const { entry, step, level = 3, showPreview = true } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3' | 'h4';
const preview = showPreview ? thumbnail(entry) : null;
const formats = formatsOf(entry);
---

<article class:list={['card', { 'has-preview': preview }]}>
  {
    preview && (
      <div class:list={['preview', { light: preview.light }]} aria-hidden="true">
        <img src={preview.src} alt="" width="720" height="405" loading="lazy" decoding="async" />
      </div>
    )
  }
  <div class="body">
    <p class="meta eyebrow">
      {step !== undefined && <span class="step">{String(step).padStart(2, '0')}</span>}
      <span>{ROLE_LABEL[entry.role]}</span>
    </p>
    <Heading class="title">
      <a href={entryUrl(entry.slug)}>{entry.title}</a>
    </Heading>
    {entry.summary && <p class="summary">{entry.summary}</p>}
    <ul class="formats" aria-label="Formats">
      {formats.map((f) => <li>{FORMAT_SHORT[f]}</li>)}
    </ul>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-2);
    overflow: hidden;
    transition:
      transform var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .card:hover,
  .card:focus-within {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--accent) 45%, var(--line));
    background: var(--surface-hover);
  }

  .preview {
    aspect-ratio: 16 / 9;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    opacity: 0.88;
    transition: transform var(--dur-3) var(--ease-out);
  }

  /* Light Mermaid exports are inverted so every thumbnail sits in the dark grid. */
  .preview.light img {
    filter: invert(0.92) hue-rotate(180deg) saturate(0.9);
  }

  .card:hover .preview img {
    transform: scale(1.03);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) var(--space-4);
    flex: 1;
  }

  .meta {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
  }

  .step {
    color: var(--accent);
  }

  .title {
    font-size: var(--step-1);
    line-height: 1.22;
    font-weight: 420;
  }

  /* The whole card is clickable via the title link's overlay. */
  .title a {
    text-decoration: none;
  }

  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .title a:focus-visible {
    outline: none;
  }

  .card:has(.title a:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .summary {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .formats {
    display: flex;
    gap: var(--space-2);
    margin-top: auto;
    padding: var(--space-2) 0 0;
    list-style: none;
  }

  .formats li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    background: var(--bg);
    color: var(--text-muted);
    border: 1px solid var(--line);
  }
</style>
